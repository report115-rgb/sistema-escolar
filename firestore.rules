rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function companyOwner(){return request.auth != null && exists(/databases/$(database)/documents/academicPlatformOwners/$(request.auth.uid)) && get(/databases/$(database)/documents/academicPlatformOwners/$(request.auth.uid)).data.active == true;}
  function tenantMaster(id){return request.auth != null && exists(/databases/$(database)/documents/academicUsers/$(request.auth.uid)) && get(/databases/$(database)/documents/academicUsers/$(request.auth.uid)).data.enabled == true && get(/databases/$(database)/documents/academicUsers/$(request.auth.uid)).data.role == 'master' && get(/databases/$(database)/documents/academicUsers/$(request.auth.uid)).data.mustChangePassword == false && get(/databases/$(database)/documents/academicUsers/$(request.auth.uid)).data.institutionId == id;}
  function maintenanceWindow(w){return w != null && w.enabled == true && request.time >= w.startAt && (w.endAt == null || request.time < w.endAt);}
  function available(id){
   let path=/databases/$(database)/documents/commercialPrivate/maintenance;
   return id == 'own' || !exists(path) || (!maintenanceWindow(get(path).data.global) && (!(id in get(path).data.institutions) || !maintenanceWindow(get(path).data.institutions[id])));
  }
  match /academicInstitutions/{institutionId}/{c}/{document}/{rest=**} {
   allow read,write: if available(institutionId) && (companyOwner() || tenantMaster(institutionId)) && c in ['courses','classes','academicCalendars','config','teachers','teacherManualLogs','teacherPaymentRates','teacherMonthlyPayments','attendance','attendanceRecords','attendanceLocks','employeeLogs','pendingUsers','systemUsers','financeLogs'];
   allow read: if available(institutionId) && (companyOwner() || tenantMaster(institutionId)) && c in ['polos','systemLogs'];
  }
  match /academicInstitutions/{institutionId}/students/{studentId} {
   allow read: if available(institutionId) && (companyOwner() || tenantMaster(institutionId));
   allow update: if available(institutionId) && (companyOwner() || tenantMaster(institutionId)) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']);
   // Criação, exclusão e mudança de status passam pelo servidor e contador transacional.
  }
  // Memberships, credentials and commercial records are server-only.
  match /{document=**} {allow read,write: if false;}
 }
}
