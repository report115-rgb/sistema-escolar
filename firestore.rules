rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function companyOwner(){return request.auth != null && exists(/databases/$(database)/documents/academicPlatformOwners/$(request.auth.uid)) && get(/databases/$(database)/documents/academicPlatformOwners/$(request.auth.uid)).data.active == true;}
  function tenantMaster(id){return request.auth != null && exists(/databases/$(database)/documents/academicUsers/$(request.auth.uid)) && get(/databases/$(database)/documents/academicUsers/$(request.auth.uid)).data.enabled == true && get(/databases/$(database)/documents/academicUsers/$(request.auth.uid)).data.role == 'master' && get(/databases/$(database)/documents/academicUsers/$(request.auth.uid)).data.mustChangePassword == false && get(/databases/$(database)/documents/academicUsers/$(request.auth.uid)).data.institutionId == id;}
  match /academicInstitutions/{institutionId}/{c}/{document}/{rest=**} {
   allow read,write: if (companyOwner() || tenantMaster(institutionId)) && c in ['students','courses','classes','academicCalendars','config','teachers','teacherManualLogs','teacherPaymentRates','teacherMonthlyPayments','attendance','attendanceRecords','attendanceLocks','employeeLogs','pendingUsers','systemUsers','financeLogs'];
   allow read: if (companyOwner() || tenantMaster(institutionId)) && c in ['polos','systemLogs'];
  }
  // Memberships, credentials and commercial records are server-only.
  match /{document=**} {allow read,write: if false;}
 }
}
