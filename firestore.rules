rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function owner(){return request.auth != null && exists(/databases/$(database)/documents/academicPlatformOwners/$(request.auth.uid)) && get(/databases/$(database)/documents/academicPlatformOwners/$(request.auth.uid)).data.active == true;}
  match /academicInstitutions/{institutionId}/{c}/{document}/{rest=**} {
   allow read,write: if owner() && c in ['students','courses','classes','academicCalendars','config','teachers','teacherManualLogs','teacherPaymentRates','teacherMonthlyPayments','attendance','attendanceRecords','attendanceLocks','employeeLogs','pendingUsers','systemUsers','financeLogs'];
   allow read: if owner() && c in ['polos','systemLogs'];
  }
  // Commercial data and owner markers stay server-only. No global browser access.
  match /{document=**} {allow read,write: if false;}
 }
}
